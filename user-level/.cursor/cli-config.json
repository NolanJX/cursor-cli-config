{
  "display": {
    "showThinkingBlocks": true
  },
  "permissions": {
    "allow": [
      "Shell(echo)",
      "Shell(git diff)",
      "Shell(git status)",
      "Shell(head)",
      "Shell(ls)",
      "Shell(pwd)",
      "Shell(rg)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Write(**/.env*)"
    ]
  }
}
